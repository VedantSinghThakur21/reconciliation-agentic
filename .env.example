# -----------------------------------------------------------------------------
# reconq-core: copy to .env and fill locally. Never commit .env.
# -----------------------------------------------------------------------------

LLM_PROVIDER=mock

# Optional CrewAI AMP leftover enrichment (disabled unless flag + both vars set)
# CREWAI_API_URL=https://your-crewai-amp-deployment.example.com
# CREWAI_BEARER_TOKEN=your-token-here
# Optional user-scoped token (if your deployment uses one)
# CREWAI_USER_BEARER_TOKEN=your-user-token-here

# Optional live LLM keys for local LangGraph AI matcher
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional thresholds (override defaults in src/pipeline.py)
# FUZZY_NAME_THRESHOLD=0.85
# AUTO_APPROVE_THRESHOLD=0.93
